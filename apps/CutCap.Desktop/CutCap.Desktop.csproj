<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>CutCap.Desktop</RootNamespace>
    <AssemblyName>CutCap</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\cutcap.ico</ApplicationIcon>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- Measured: ~40% faster window-to-screen and ~40 MB less working set at startup.
         Native AOT is not enabled; see docs/AVALONIA_MIGRATION_REPORT.md. -->
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src-dotnet\CutCap.Interop\CutCap.Interop.csproj" />
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Icons\**" />
    <!-- SVG sources for scripts/generate-icons.py; not shipped. -->
    <None Include="Assets\Icons\**" />
  </ItemGroup>
</Project>
