<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CutCap.Desktop.ViewModels"
        xmlns:v="using:CutCap.Desktop.Views"
        xmlns:c="using:CutCap.Desktop.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="CutCap.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding ProjectCaption, StringFormat='{}{0} — CutCap'}"
        Icon="avares://CutCap/Assets/cutcap.ico"
        Width="1440" Height="900" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+I" Command="{Binding ImportCommand}" />
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewProjectCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenProjectCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveProjectCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveProjectAsCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+A" Command="{Binding ClearSelectionCommand}" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding ResetLayoutCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding Timeline.ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+Add" Command="{Binding Timeline.ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding Timeline.ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding Timeline.ZoomOutCommand}" />
  </Window.KeyBindings>
  <Window.Styles>
    <!-- Title-bar controls must receive input inside the extended chrome area. -->
    <ContainerQuery Name="titlebar" Query="max-width:1180">
      <Style Selector="TextBlock.wide-label">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </ContainerQuery>
    <Style Selector="Border#TitleBar Button">
      <Setter Property="chrome:WindowDecorationProperties.ElementRole" Value="User" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Title bar: identity, status, project, workspace actions. Windows draws the
         caption buttons; the right margin keeps our controls clear of them. -->
    <Border Name="TitleBar" DockPanel.Dock="Top" Height="44" Background="{StaticResource Ground}"
            Container.Name="titlebar" Container.Sizing="Width"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" Margin="14,0,0,0">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Border Width="20" Height="20" CornerRadius="5" Background="{StaticResource MarkGradient}"
                  AutomationProperties.Name="CutCap" ToolTip.Tip="CutCap">
            <Path Data="M7.4,5.4 L7.4,14.6 L14.6,10 Z" Fill="#06191C" />
          </Border>
          <TextBlock Text="CutCap" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
          <Border Classes="vrule" Height="18" />
          <c:IconView Glyph="CheckCircle" Width="14" Height="14" Foreground="{StaticResource Success}"
                      IsVisible="{Binding !StatusIsError}" />
          <c:IconView Glyph="AlertCircle" Width="14" Height="14" Foreground="{StaticResource Error}"
                      IsVisible="{Binding StatusIsError}" />
          <TextBlock Text="{Binding StatusText}" Classes="label muted" Classes.error="{Binding StatusIsError}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="250"
                     ToolTip.Tip="{Binding StatusText}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" MaxWidth="320" />
          <Border Background="{StaticResource Raised}" CornerRadius="3" Padding="6,1"
                  ToolTip.Tip="{Binding ProjectPath}">
            <TextBlock Text="{Binding ProjectStateText}" Classes="fine faint" />
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                    Margin="0,0,196,0">
          <Button Classes="tool" AutomationProperties.Name="Project menu" ToolTip.Tip="New, open and save project">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:IconView Glyph="New" />
              <TextBlock Text="Project" Classes="wide-label" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="New project" Command="{Binding NewProjectCommand}" InputGesture="Ctrl+N" />
                <MenuItem Header="Open project…" Command="{Binding OpenProjectCommand}" InputGesture="Ctrl+O" />
                <Separator />
                <MenuItem Header="Save" Command="{Binding SaveProjectCommand}" InputGesture="Ctrl+S" />
                <MenuItem Header="Save As…" Command="{Binding SaveProjectAsCommand}" InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="Undo" Command="{Binding Timeline.UndoCommand}" InputGesture="Ctrl+Z" />
                <MenuItem Header="Redo" Command="{Binding Timeline.RedoCommand}" InputGesture="Ctrl+Y" />
                <Separator />
                <MenuItem Header="Relink selected source…" Command="{Binding RelinkMediaCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="filled" AutomationProperties.Name="Keyboard shortcuts" ToolTip.Tip="Show keyboard shortcuts">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:IconView Glyph="Keyboard" />
              <TextBlock Text="Shortcuts" Classes="wide-label" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <v:ShortcutsView />
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Classes="tool" Command="{Binding ResetLayoutCommand}" AutomationProperties.Name="Reset layout"
                  ToolTip.Tip="Restore panel sizes and timeline zoom (Ctrl+0)">
            <c:IconView Glyph="Layout" />
          </Button>
          <Button Classes="tool" AutomationProperties.Name="About CutCap" ToolTip.Tip="About CutCap">
            <c:IconView Glyph="Info" />
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <v:AboutView />
              </Flyout>
            </Button.Flyout>
          </Button>
          <Border Classes="vrule" Height="18" />
          <Button Classes="primary" IsEnabled="False" AutomationProperties.Name="Export"
                  ToolTip.Tip="Export is not available yet. It arrives with the render pipeline.">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:IconView Glyph="Export" />
              <TextBlock Text="Export" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Workspace: assets | player | inspector over a full-width timeline. -->
    <Grid Name="Workspace" Margin="6,0,6,6">
      <Grid.RowDefinitions>
        <RowDefinition Height="58*" MinHeight="250" />
        <RowDefinition Height="6" />
        <RowDefinition Height="42*" MinHeight="170" />
      </Grid.RowDefinitions>
      <Grid Name="Upper">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="34*" MinWidth="290" MaxWidth="600" />
          <ColumnDefinition Width="6" />
          <ColumnDefinition Width="41*" MinWidth="340" />
          <ColumnDefinition Width="6" />
          <ColumnDefinition Width="25*" MinWidth="240" MaxWidth="480" />
        </Grid.ColumnDefinitions>
        <v:AssetPanel Grid.Column="0" />
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" AutomationProperties.Name="Resize media panel" />
        <v:PlayerPanel Grid.Column="2" DataContext="{Binding Player}" />
        <GridSplitter Grid.Column="3" ResizeDirection="Columns" AutomationProperties.Name="Resize inspector" />
        <v:InspectorPanel Grid.Column="4" DataContext="{Binding Inspector}" />
      </Grid>
      <GridSplitter Grid.Row="1" ResizeDirection="Rows" AutomationProperties.Name="Resize timeline" />
      <v:TimelinePanel Grid.Row="2" DataContext="{Binding Timeline}" />
    </Grid>
  </DockPanel>
</Window>
