<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CutCap.Desktop.Views.AboutView"
             Width="340">
  <StackPanel Margin="6" Spacing="8">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource MarkGradient}">
        <Path Data="M11,8 L11,22 L22,15 Z" Fill="#06191C" />
      </Border>
      <TextBlock Text="CutCap" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock Text="Version 0.3.0 (development build)" Classes="label muted" />
    <TextBlock Classes="label muted" TextWrapping="Wrap"
               Text="An offline video editor in development. Importing and stepping through real source frames works today; playback, editing and export are not available yet." />
    <TextBlock Classes="fine faint" TextWrapping="Wrap"
               Text="Interface: Avalonia UI (MIT). Typeface: Inter (SIL Open Font License 1.1). Media: your separately installed FFmpeg/FFprobe, which CutCap does not bundle." />
  </StackPanel>
</UserControl>
