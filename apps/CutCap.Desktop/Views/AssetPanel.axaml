<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CutCap.Desktop.ViewModels"
             xmlns:c="using:CutCap.Desktop.Controls"
             x:Class="CutCap.Desktop.Views.AssetPanel"
             x:DataType="vm:MainWindowViewModel">
  <Border Classes="panel">
    <DockPanel>
      <!-- Tool categories. Only Media is backed by the engine; the others say so. -->
      <TabStrip DockPanel.Dock="Top" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                ItemContainerTheme="{StaticResource CategoryTab}" Margin="4,4,4,2"
                AutomationProperties.Name="Asset categories">
        <TabStrip.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </TabStrip.ItemsPanel>
        <TabStrip.ItemTemplate>
          <DataTemplate x:DataType="vm:CategoryViewModel">
            <StackPanel Spacing="3" AutomationProperties.Name="{Binding Name}">
              <c:IconView Glyph="{Binding Glyph}" Width="18" Height="18" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding Name}" FontSize="10.5" HorizontalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </TabStrip.ItemTemplate>
      </TabStrip>
      <Border DockPanel.Dock="Top" Classes="divider" Height="1" />

      <Panel>
        <!-- Media: real imported sources. -->
        <Grid ColumnDefinitions="96,1,*" IsVisible="{Binding ShowMediaCategory}">
          <ListBox ItemsSource="{Binding Library.Collections}" SelectedIndex="{Binding Library.Filter}"
                   ItemContainerTheme="{StaticResource NavItem}" Background="Transparent" Margin="6,8,6,0"
                   IsEnabled="{Binding Library.HasItems}" AutomationProperties.Name="Media collections" />
          <Border Grid.Column="1" Classes="divider" />
          <DockPanel Grid.Column="2" Margin="10,10,4,0">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,6,0">
              <TextBox Classes="compact" Text="{Binding Library.SearchText}" PlaceholderText="Search media"
                       IsEnabled="{Binding Library.HasItems}" AutomationProperties.Name="Search imported media by name">
                <TextBox.InnerLeftContent>
                  <c:IconView Glyph="Search" Width="14" Height="14" Margin="8,0,0,0" Foreground="{StaticResource Faint}" />
                </TextBox.InnerLeftContent>
              </TextBox>
              <Button Grid.Column="1" Classes="filled" Margin="6,0,0,0" Command="{Binding ImportCommand}"
                      AutomationProperties.Name="Import media" ToolTip.Tip="Import a local video or audio file (Ctrl+I)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:IconView Glyph="Import" />
                  <TextBlock Text="Import" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>

            <!-- Import progress and results. -->
            <Border DockPanel.Dock="Top" Margin="0,8,6,0" Padding="10,7" CornerRadius="5" Background="{StaticResource Well}"
                    IsVisible="{Binding Library.ImportBusy}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Library.BusyText}" Classes="label muted" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Classes="tool" Command="{Binding Library.CancelImportCommand}"
                        IsVisible="{Binding Library.ShowImportProgress}"
                        AutomationProperties.Name="Cancel import" ToolTip.Tip="Cancel the current import">
                  <c:IconView Glyph="Close" Width="12" Height="12" />
                </Button>
              </Grid>
            </Border>
            <Border DockPanel.Dock="Top" Margin="0,8,6,0" Padding="10,7" CornerRadius="5"
                    Background="{StaticResource Well}" IsVisible="{Binding Library.ShowMessage}">
              <TextBlock Text="{Binding Library.ImportMessage}" Classes="label muted" Classes.error="{Binding Library.ImportError}"
                         TextWrapping="Wrap" />
            </Border>

            <TextBlock DockPanel.Dock="Top" Margin="0,12,0,8" Classes="fine faint"
                       Text="{Binding Library.CountText}" IsVisible="{Binding Library.HasItems}" />

            <Panel>
              <!-- Empty library: one clear call to action. -->
              <StackPanel IsVisible="{Binding Library.IsEmpty}" Margin="0,10,6,0" Spacing="12">
                <Button Classes="tool" Command="{Binding ImportCommand}" Height="132" HorizontalAlignment="Stretch"
                        Background="{StaticResource Well}" BorderBrush="{StaticResource BorderLine}" BorderThickness="1"
                        AutomationProperties.Name="Import media">
                  <StackPanel Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource Accent}" HorizontalAlignment="Center">
                      <c:IconView Glyph="Plus" Foreground="{StaticResource AccentInk}" Width="18" Height="18" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Import" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" />
                    <TextBlock Text="Choose a local video or audio file · Ctrl+I" Classes="fine faint" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
                <TextBlock Text="No media yet" FontWeight="SemiBold" />
                <TextBlock Classes="label faint" TextWrapping="Wrap"
                           Text="Imported media appears here with its real duration and format. CutCap never changes the original file." />
              </StackPanel>

              <TextBlock IsVisible="{Binding Library.HasNoMatches}" Text="{Binding Library.NoMatchesText}"
                         Classes="label faint" TextWrapping="Wrap" Margin="0,4,6,0" />

              <ListBox Name="MediaGrid" ItemsSource="{Binding Library.Visible}" SelectedItem="{Binding Library.SelectedItem}"
                       ItemContainerTheme="{StaticResource MediaTile}" Background="Transparent"
                       IsVisible="{Binding Library.HasItems}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       AutomationProperties.Name="Imported media">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:MediaItemViewModel">
                    <!-- No thumbnail is invented: poster frames need an engine API, so the
                         tile shows the media family and the real duration. -->
                    <StackPanel Width="112" Spacing="5" AutomationProperties.Name="{Binding AccessibleName}"
                                ToolTip.Tip="{Binding Tooltip}">
                      <Border Classes="thumb" Height="63" CornerRadius="6" BorderThickness="2"
                              Background="{StaticResource TileGradient}" ClipToBounds="True">
                        <Panel>
                          <c:IconView Glyph="{Binding TileGlyph}" Width="20" Height="20" HorizontalAlignment="Center" Foreground="{StaticResource Faint}" />
                          <Border IsVisible="{Binding HasAudio}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Margin="4" Padding="3,2" CornerRadius="3" Background="#A0000000">
                            <c:IconView Glyph="AudioBadge" Width="11" Height="11" Foreground="{StaticResource Audio}" />
                          </Border>
                          <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" Padding="4,1"
                                  CornerRadius="3" Background="#B0000000">
                            <TextBlock Text="{Binding Stamp}" Classes="mono" FontSize="10" Foreground="White" />
                          </Border>
                        </Panel>
                      </Border>
                      <TextBlock Classes="fine muted tile-name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="fine muted" Classes.error="{Binding Unavailable}" Text="{Binding AvailabilityText}"
                                 IsVisible="{Binding ShowAvailability}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Panel>
          </DockPanel>
        </Grid>

        <!-- Categories the engine cannot back yet: a deliberate, honest state. -->
        <StackPanel IsVisible="{Binding ShowUnavailableCategory}" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="8" MaxWidth="300" Margin="20">
          <c:IconView Glyph="{Binding SelectedCategory.Glyph}" Width="30" Height="30" Foreground="{StaticResource Faint}"
                      HorizontalAlignment="Center" StrokeThickness="1.2" />
          <TextBlock Text="{Binding SelectedCategory.Title}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
          <TextBlock Text="{Binding SelectedCategory.Detail}" Classes="label faint" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
      </Panel>
    </DockPanel>
  </Border>
</UserControl>
