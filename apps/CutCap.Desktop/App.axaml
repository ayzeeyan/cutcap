<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CutCap.Desktop.App"
             RequestedThemeVariant="Dark"
             Name="CutCap">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://CutCap/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://CutCap/Themes/ControlThemes.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://CutCap/Themes/Styles.axaml" />
  </Application.Styles>
</Application>
