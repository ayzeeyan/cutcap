<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:CutCap.Desktop.Controls">
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource Ground}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="{StaticResource BodySize}" />
  </Style>

  <!-- Avalonia draws the window decorations in an overlay above the window.
       CutCap draws its own title row, so only the drawn title text is hidden;
       the caption buttons (full screen, minimize, maximize, close) stay. -->
  <Style Selector="Panel#PART_TitleTextPanel > TextBlock">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button.tool">
    <Setter Property="Theme" Value="{StaticResource ToolButton}" />
  </Style>
  <Style Selector="Button.filled">
    <Setter Property="Theme" Value="{StaticResource FilledButton}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Theme" Value="{StaticResource PrimaryButton}" />
  </Style>
  <Style Selector="Button.round">
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- Panels float on the ground with thin gutters. -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="CornerRadius" Value="{StaticResource PanelRadius}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Background" Value="{StaticResource Line}" />
  </Style>
  <Style Selector="Border.vrule">
    <Setter Property="Background" Value="{StaticResource BorderLine}" />
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="6,8" />
  </Style>

  <!-- Text roles -->
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{StaticResource Faint}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="{StaticResource LabelSize}" />
  </Style>
  <Style Selector="TextBlock.fine">
    <Setter Property="FontSize" Value="{StaticResource FineSize}" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{StaticResource TitleSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{StaticResource Error}" />
  </Style>

  <!-- Icons default to 16 px and inherit the surrounding foreground. -->
  <Style Selector="c|IconView">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Media tiles: ring around the frame-shaped thumbnail when selected or focused. -->
  <Style Selector="ListBoxItem Border.thumb">
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ListBoxItem:pointerover Border.thumb">
    <Setter Property="BorderBrush" Value="{StaticResource BorderLine}" />
  </Style>
  <Style Selector="ListBoxItem:selected Border.thumb">
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="ListBoxItem:focus-visible Border.thumb">
    <Setter Property="BorderBrush" Value="{StaticResource AccentHover}" />
  </Style>
  <Style Selector="ListBoxItem:selected TextBlock.tile-name">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ListBoxItem:selected TextBlock.track-name">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Inspector rows -->
  <Style Selector="Expander.section">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="4,0,4,10" />
  </Style>

  <!-- Compact text inputs -->
  <Style Selector="TextBox.compact">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>

  <!-- Splitters are the gutters; they light up when used. -->
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="6" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Focusable" Value="True" />
  </Style>
  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="{StaticResource BorderLine}" />
  </Style>
  <Style Selector="GridSplitter:focus-visible">
    <Setter Property="Background" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="GridSplitter:pressed">
    <Setter Property="Background" Value="{StaticResource Accent}" />
  </Style>
</Styles>
