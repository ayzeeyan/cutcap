import { Theme } from "../theme.slint";
import { TrackRow } from "../models.slint";

// Track state glyph. Visibility, mute and lock need the editing engine, so
// these are shown disabled with an explanation rather than faked.
component TrackToggle inherits Rectangle {
    in property <image> icon;
    in property <string> hint;
    width: 22px; height: 22px;
    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.hover.with-alpha(0.5) : transparent;
    Image { source: root.icon; colorize: Theme.faint.with-alpha(0.8); width: 14px; height: 14px; }
    touch := TouchArea { }
    Tooltip { text: @markdown("\{root.hint}"); }
}

// Fixed track identity column entry. Selecting goes through the engine; the
// row only reflects the snapshot's selection state.
export component TrackHeader inherits Rectangle {
    in property <TrackRow> track;
    in property <int> index;
    in property <int> count;
    in property <bool> enabled;
    in property <int> focus-target: -1;
    in property <int> focus-serial;
    callback activate();
    callback move(int);
    changed focus-serial => {
        if root.focus-target == root.index { scope.focus(); }
    }
    private property <bool> video: root.track.kind == "VIDEO";
    background: root.track.selected ? Theme.accent-wash : touch.has-hover && root.enabled ? Theme.well : Theme.panel;
    accessible-role: list-item;
    accessible-label: root.track.name;
    accessible-description: (root.video ? "Video track" : "Audio track") + ", empty. Enter selects; Up and Down move between tracks.";
    accessible-enabled: root.enabled;
    accessible-item-selectable: true;
    accessible-item-selected: root.track.selected;
    accessible-item-index: root.index;
    accessible-item-count: root.count;
    accessible-action-default => { if root.enabled { root.activate(); } }
    forward-focus: scope;
    scope := FocusScope {
        x: 0; y: 0; width: 100%; height: 100%;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.activate(); return accept; }
            if event.text == Key.UpArrow { root.move(-1); return accept; }
            if event.text == Key.DownArrow { root.move(1); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        x: 0; y: 0; width: 100%; height: 100%;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { scope.focus(); root.activate(); }
    }
    badge := Rectangle {
        x: 10px; y: (parent.height - self.height) / 2;
        width: 26px; height: 18px;
        border-radius: 3px;
        background: root.video ? Theme.video-fill : Theme.audio-fill;
        border-width: root.track.selected ? 1px : 0px;
        border-color: Theme.pencil.with-alpha(0.85);
        Text { text: root.track.badge; color: Theme.pencil; font-size: Theme.fine-size; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
    Text {
        x: badge.x + badge.width + 8px; y: 0;
        width: toggles.x - self.x - 4px; height: parent.height;
        text: root.track.name; color: root.track.selected ? Theme.text : Theme.muted; font-size: Theme.label-size; font-weight: root.track.selected ? 600 : 400;
        vertical-alignment: center; overflow: elide;
    }
    toggles := HorizontalLayout {
        x: parent.width - self.preferred-width - 6px; y: (parent.height - 22px) / 2; height: 22px;
        spacing: 0px;
        if root.video : TrackToggle { icon: @image-url("../assets/icons/eye.svg"); hint: "Track visibility arrives with the editing engine."; }
        if !root.video : TrackToggle { icon: @image-url("../assets/icons/volume.svg"); hint: "Track mute arrives with the editing engine."; }
        TrackToggle { icon: @image-url("../assets/icons/lock.svg"); hint: "Track locking arrives with the editing engine."; }
    }
    if scope.has-focus : Rectangle {
        x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 5px;
        border-radius: Theme.radius; border-width: 1.5px; border-color: Theme.accent;
    }
}
