import { ScrollView } from "std-widgets.slint";
import { Theme, Timecode } from "../theme.slint";
import { TrackRow } from "../models.slint";
import { ActionButton } from "action-button.slint";
import { TrackHeader } from "track-header.slint";

// Timeline zoom control (50-200 %). View state only; never part of the project.
component ZoomSlider inherits Rectangle {
    in-out property <int> value: 100;
    private property <float> fraction: (root.value - 50) / 150;
    height: 28px;
    accessible-role: slider;
    accessible-label: "Timeline zoom";
    accessible-value: root.value + "%";
    accessible-value-minimum: 50;
    accessible-value-maximum: 200;
    accessible-value-step: 25;
    accessible-action-increment => { root.value = min(200, root.value + 25); }
    accessible-action-decrement => { root.value = max(50, root.value - 25); }
    forward-focus: scope;
    function set-at(x: length) {
        root.value = round(clamp((x - 6px) / (root.width - 12px), 0, 1) * 30) * 5 + 50;
    }
    Rectangle { x: 6px; width: parent.width - 12px; height: 3px; border-radius: 1.5px; background: Theme.line-strong; }
    Rectangle { x: 6px; width: (parent.width - 12px) * root.fraction; height: 3px; border-radius: 1.5px; background: Theme.muted; }
    Rectangle {
        x: 6px + (parent.width - 12px) * root.fraction - 5px; width: 10px; height: 10px; border-radius: 5px;
        background: Theme.pencil;
        border-width: scope.has-focus ? 2px : 0px; border-color: Theme.accent;
    }
    scope := FocusScope {
        key-pressed(event) => {
            if event.text == Key.RightArrow || event.text == Key.UpArrow { root.value = min(200, root.value + 25); return accept; }
            if event.text == Key.LeftArrow || event.text == Key.DownArrow { root.value = max(50, root.value - 25); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { scope.focus(); root.set-at(self.mouse-x); }
        }
        moved => { if self.pressed { root.set-at(self.mouse-x); } }
    }
    Tooltip { text: @markdown("Timeline zoom. Drag, or use the arrow keys to step 25%."); }
}

component ToolDivider inherits Rectangle {
    width: 9px; horizontal-stretch: 0;
    Rectangle { x: 4px; y: 7px; width: 1px; height: parent.height - 14px; background: Theme.line-strong; }
}

// Track headers and the ruler stay fixed while lanes scroll; both follow the
// lane viewport. The ruler is a view range, not project duration, and the
// playhead stays at timeline zero until a timeline transport exists.
export component TimelinePanel inherits Rectangle {
    in property <[TrackRow]> tracks;
    in property <bool> ready;
    in-out property <int> zoom: 100;
    callback add-track(bool);
    callback select-track(int);
    background: Theme.panel;
    border-radius: Theme.panel-radius;
    clip: true;
    private property <length> second-width: 20px * root.zoom / 100;
    private property <int> label-step: root.zoom >= 150 ? 2 : root.zoom >= 75 ? 3 : 6;
    private property <int> view-seconds: max(60, ceil(lanes.visible-width / root.second-width));
    private property <int> focus-target: -1;
    private property <int> focus-serial;
    private property <length> lane-height: root.tracks.length * Theme.track-height;
    private property <length> body-y: Theme.heading-height;
    // Time zero sits slightly inside the lanes so the playhead head is never clipped.
    private property <length> origin: 10px;

    function scroll-y-to(target: length) {
        lanes.content-y = clamp(target, min(0px, lanes.visible-height - lanes.content-height), 0px);
    }
    function scroll-x-to(target: length) {
        lanes.content-x = clamp(target, min(0px, lanes.visible-width - lanes.content-width), 0px);
    }

    toolbar := HorizontalLayout {
        x: 0; y: 0; width: 100%; height: Theme.heading-height;
        padding-left: 8px; padding-right: 10px; padding-top: 5px; padding-bottom: 5px; spacing: 2px;
        // Editing tools the engine cannot back yet stay visible, disabled.
        ActionButton { subtle: true; icon: @image-url("../assets/icons/undo.svg"); name: "Undo"; enabled: false; hint: "Undo arrives with the editing engine."; }
        ActionButton { subtle: true; icon: @image-url("../assets/icons/redo.svg"); name: "Redo"; enabled: false; hint: "Redo arrives with the editing engine."; }
        ToolDivider { }
        ActionButton { subtle: true; icon: @image-url("../assets/icons/scissors.svg"); name: "Split clip"; enabled: false; hint: "Splitting clips arrives with the editing engine."; }
        ActionButton { subtle: true; icon: @image-url("../assets/icons/trash.svg"); name: "Delete clip"; enabled: false; hint: "Deleting clips arrives with the editing engine."; }
        ToolDivider { }
        ActionButton { subtle: true; text: root.width > 720px ? "Video track" : ""; icon: @image-url("../assets/icons/video-track.svg"); name: "Add video track"; enabled: root.ready && root.tracks.length < 128; hint: "Add an empty video track"; clicked => { root.add-track(false); } }
        ActionButton { subtle: true; text: root.width > 720px ? "Audio track" : ""; icon: @image-url("../assets/icons/audio-track.svg"); name: "Add audio track"; enabled: root.ready && root.tracks.length < 128; hint: "Add an empty audio track"; clicked => { root.add-track(true); } }
        Rectangle { horizontal-stretch: 1; }
        Rectangle {
            width: playhead-time.preferred-width + 12px; horizontal-stretch: 0;
            playhead-time := Text {
                text: Timecode.precise(0);
                color: Theme.muted; font-family: Theme.mono-family; font-size: Theme.timecode-size;
                vertical-alignment: center;
                accessible-label: "Timeline playhead at 00:00.000; timeline playback is not available yet";
            }
            TouchArea { }
            Tooltip { text: @markdown("Timeline playhead. It stays at zero until clips and timeline playback exist; the source preview never moves it."); }
        }
        ToolDivider { }
        ActionButton { subtle: true; icon: @image-url("../assets/icons/zoom-out.svg"); name: "Zoom out"; enabled: root.zoom > 50; hint: "Zoom the timeline view out (Ctrl+Minus)"; clicked => { root.zoom = max(50, root.zoom - 25); } }
        if root.width > 600px : ZoomSlider { width: 110px; value <=> root.zoom; }
        ActionButton { subtle: true; icon: @image-url("../assets/icons/zoom-in.svg"); name: "Zoom in"; enabled: root.zoom < 200; hint: "Zoom the timeline view in (Ctrl+Plus)"; clicked => { root.zoom = min(200, root.zoom + 25); } }
        ActionButton { subtle: true; text: root.zoom + "%"; name: "Reset zoom, currently " + root.zoom + " percent"; hint: "Click to reset the timeline view to 100%"; clicked => { root.zoom = 100; } }
    }
    Rectangle { x: 0; y: root.body-y - 1px; width: 100%; height: 1px; background: Theme.line; }

    corner := Rectangle {
        x: 0; y: root.body-y; width: Theme.track-header-width; height: Theme.ruler-height;
        Text {
            x: 10px; height: 100%;
            text: root.tracks.length == 1 ? "1 track" : root.tracks.length + " tracks";
            color: Theme.faint; font-size: Theme.fine-size;
            vertical-alignment: center;
        }
    }
    ruler := Rectangle {
        x: Theme.track-header-width; y: root.body-y;
        width: parent.width - Theme.track-header-width; height: Theme.ruler-height;
        clip: true;
        accessible-role: text;
        accessible-label: "Timeline ruler, view range " + Timecode.seconds(0) + " to " + Timecode.seconds(root.view-seconds);
        for second in root.view-seconds + 1 : Rectangle {
            x: root.origin + second * root.second-width + lanes.content-x;
            width: 1px;
            height: mod(second, root.label-step) == 0 ? 10px : 4px;
            y: parent.height - self.height - 2px;
            background: mod(second, root.label-step) == 0 ? Theme.faint : Theme.line-strong;
        }
        for mark in floor(root.view-seconds / root.label-step) + 1 : Text {
            x: root.origin + mark * root.label-step * root.second-width + lanes.content-x + 7px; y: 5px;
            text: Timecode.seconds(mark * root.label-step);
            color: Theme.faint; font-family: Theme.mono-family; font-size: 10px;
        }
        // Playhead head at timeline zero.
        Rectangle {
            x: root.origin + lanes.content-x - 4px; y: 3px; width: 9px; height: 14px;
            background: Theme.pencil; border-radius: 3px;
        }
        Rectangle {
            x: root.origin + lanes.content-x; y: 17px; width: 1px; height: parent.height - 17px;
            background: Theme.pencil;
        }
        TouchArea {
            scroll-event(event) => {
                root.scroll-x-to(lanes.content-x + (event.delta-x != 0 ? event.delta-x : event.delta-y));
                return accept;
            }
        }
    }
    headers := Rectangle {
        x: 0; y: root.body-y + Theme.ruler-height;
        width: Theme.track-header-width; height: parent.height - self.y;
        clip: true;
        TouchArea {
            scroll-event(event) => {
                root.scroll-y-to(lanes.content-y + event.delta-y);
                return accept;
            }
        }
        for row[index] in root.tracks : TrackHeader {
            x: 0; width: parent.width - 1px;
            y: index * Theme.track-height + lanes.content-y; height: Theme.track-height;
            track: row; index: index; count: root.tracks.length; enabled: root.ready;
            focus-target: root.focus-target; focus-serial: root.focus-serial;
            activate => { root.select-track(index); }
            move(delta) => {
                let target = clamp(index + delta, 0, root.tracks.length - 1);
                if target != index {
                    root.select-track(target);
                    let top = target * Theme.track-height;
                    if top + lanes.content-y < 0 {
                        root.scroll-y-to(-top);
                    } else if top + Theme.track-height + lanes.content-y > lanes.visible-height {
                        root.scroll-y-to(lanes.visible-height - top - Theme.track-height);
                    }
                    root.focus-target = target;
                    root.focus-serial += 1;
                }
            }
        }
        Rectangle { x: parent.width - 1px; width: 1px; height: 100%; background: Theme.line; }
    }
    lanes := ScrollView {
        x: Theme.track-header-width; y: root.body-y + Theme.ruler-height;
        width: parent.width - Theme.track-header-width; height: parent.height - self.y;
        content-width: max(self.visible-width, root.origin + root.view-seconds * root.second-width + 32px);
        content-height: max(self.visible-height, root.lane-height + Theme.inset);
        Rectangle {
            x: 0; y: 0;
            width: lanes.content-width; height: lanes.content-height;
            // One band per track; empty until clips can be placed.
            for row[index] in root.tracks : Rectangle {
                x: 2px; width: parent.width - 4px;
                y: index * Theme.track-height + 5px; height: Theme.track-height - 10px;
                border-radius: Theme.radius;
                background: row.selected ? Theme.accent-lane : Theme.well;
                border-width: row.selected ? 1px : 0px;
                border-color: Theme.accent.with-alpha(0.45);
                Text {
                    x: root.origin + Theme.inset; height: 100%;
                    text: row.kind == "VIDEO" ? "Empty video track" : "Empty audio track";
                    color: Theme.faint; font-size: Theme.fine-size; vertical-alignment: center;
                }
            }
            if root.tracks.length == 0 : Text {
                x: Theme.inset; y: Theme.inset;
                text: "No tracks. Add a video or audio track to begin.";
                color: Theme.muted; font-size: Theme.body-size;
            }
            Rectangle { x: root.origin; y: 0; width: 1px; height: max(Theme.track-height, root.lane-height); background: Theme.pencil; }
        }
    }
    // Fixed to the viewport (not scrolled) so it stays readable at any zoom.
    if root.tracks.length > 0 && root.lane-height + lanes.content-y + 40px < lanes.height : Text {
        x: lanes.x + root.origin + Theme.inset; y: lanes.y + root.lane-height + lanes.content-y + Theme.inset;
        width: lanes.width - root.origin - 2 * Theme.inset;
        text: "Placing clips on the timeline arrives with the editing engine. Use the source preview to inspect footage today.";
        color: Theme.faint; font-size: Theme.label-size; overflow: elide;
    }
}
