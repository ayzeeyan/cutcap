import { Theme } from "../theme.slint";

// Compact timecode entry in the app's own control vocabulary.
export component TimeField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> name;
    in property <bool> enabled: true;
    callback accepted(string);
    height: Theme.control-height;
    border-radius: Theme.radius;
    background: !root.enabled ? Theme.raised.with-alpha(0.5) : input.has-focus ? Theme.stage : touch.has-hover ? Theme.hover : Theme.raised;
    border-width: input.has-focus ? 1.5px : 0px;
    border-color: Theme.accent;
    accessible-role: text-input;
    accessible-label: root.name;
    accessible-value: root.text;
    accessible-enabled: root.enabled;
    accessible-placeholder-text: root.placeholder;
    accessible-action-set-value(value) => { root.text = value; }
    forward-focus: input;
    touch := TouchArea { mouse-cursor: MouseCursor.text; clicked => { input.focus(); } }
    if root.text == "" : Text {
        x: Theme.gap; width: parent.width - 2 * Theme.gap; height: 100%;
        text: root.placeholder; color: Theme.faint;
        font-family: Theme.mono-family; font-size: Theme.label-size; vertical-alignment: center;
    }
    input := TextInput {
        x: Theme.gap; width: parent.width - 2 * Theme.gap; height: 100%;
        text <=> root.text;
        enabled: root.enabled;
        single-line: true;
        color: root.enabled ? Theme.text : Theme.faint;
        selection-background-color: Theme.accent.with-alpha(0.35);
        selection-foreground-color: Theme.text;
        font-family: Theme.mono-family; font-size: Theme.label-size;
        vertical-alignment: center;
        accepted => { root.accepted(self.text); }
        changed has-focus => { if self.has-focus { self.select-all(); } }
    }
}
