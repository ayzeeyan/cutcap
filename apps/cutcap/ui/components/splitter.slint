import { Theme } from "../theme.slint";

// The gutter between panels is the resize handle; it lights an accent line when
// hovered, dragged or focused.
export component Splitter inherits Rectangle {
    in property <bool> horizontal: false;
    in property <string> label;
    callback adjust(length);
    private property <bool> live: touch.has-hover || touch.pressed || scope.has-focus;
    forward-focus: scope;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: "Drag to resize. Arrow keys resize in 8 pixel steps.";
    Rectangle {
        x: root.horizontal ? 0 : (parent.width - self.width) / 2;
        y: root.horizontal ? (parent.height - self.height) / 2 : 0;
        width: root.horizontal ? parent.width : 2px;
        height: root.horizontal ? 2px : parent.height;
        background: root.live ? (scope.has-focus || touch.pressed ? Theme.accent : Theme.line-strong) : transparent;
    }
    scope := FocusScope {
        x: 0; y: 0; width: 100%; height: 100%;
        key-pressed(event) => {
            if event.text == Key.LeftArrow || event.text == Key.UpArrow { root.adjust(-8px); return accept; }
            if event.text == Key.RightArrow || event.text == Key.DownArrow { root.adjust(8px); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        x: 0; y: 0; width: 100%; height: 100%;
        mouse-cursor: root.horizontal ? row-resize : col-resize;
        pointer-event(event) => { if event.kind == down { scope.focus(); } }
        moved => { if self.pressed { root.adjust(root.horizontal ? self.mouse-y - self.pressed-y : self.mouse-x - self.pressed-x); } }
    }
    Tooltip { text: @markdown("Drag, or focus and use the arrow keys, to resize"); }
}
