import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ActionButton } from "action-button.slint";
import { PanelHeading } from "panel-heading.slint";

export component InspectorPanel inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <string> timebase;
    in property <bool> selected;
    in property <int> track-count;
    callback clear-selection();
    background: Theme.panel;
    PanelHeading { title: "Inspector"; detail: root.selected ? "Track" : "Project"; }
    ScrollView {
        x: 0; width: 100%;
        y: Theme.heading-height; height: parent.height - Theme.heading-height;
        VerticalLayout {
            x: 0; y: 0; width: parent.width;
            padding: Theme.inset; spacing: Theme.inset; alignment: start;
            Text { text: root.title; color: Theme.text; font-size: 18px; font-weight: 600; wrap: word-wrap; }
            Text { text: root.detail; color: Theme.secondary; font-size: Theme.body-size; wrap: word-wrap; }
            Rectangle { height: 1px; background: Theme.line; }
            Text { text: root.selected ? "Contents" : "Timeline"; color: Theme.text; font-size: Theme.body-size; font-weight: 600; }
            Text { text: root.selected ? "0 clips on this track" : root.track-count + " tracks · 0 clips"; color: Theme.secondary; font-size: Theme.body-size; wrap: word-wrap; }
            Text { text: "Timeline clock"; color: Theme.text; font-size: Theme.body-size; font-weight: 600; }
            Text { text: root.timebase; color: Theme.secondary; font-size: Theme.label-size; wrap: word-wrap; }
            Rectangle { height: 1px; background: Theme.line; }
            Text { text: "No clip selected"; color: Theme.text; font-size: Theme.body-size; font-weight: 600; }
            Text { text: "Clip properties and effects will appear here once timeline editing is available."; color: Theme.secondary; font-size: Theme.body-size; wrap: word-wrap; }
            if root.selected : ActionButton { text: "Clear selection"; hint: "Return to the project overview · Ctrl+Shift+A"; clicked => { root.clear-selection(); } }
        }
    }
}
