import { Theme } from "../theme.slint";
import { ActionButton } from "action-button.slint";
import { PanelHeading } from "panel-heading.slint";
import { Slider, LineEdit } from "std-widgets.slint";

export component ViewerPanel inherits Rectangle {
    in property <string> status;
    in property <string> detail;
    in property <image> frame;
    in property <bool> has-frame;
    in property <bool> busy;
    in property <bool> ready;
    in property <float> aspect: 16 / 9;
    in property <string> source-title: "No source selected";
    in property <string> caption;
    in property <int> position-ms;
    in property <int> duration-ms;
    // Widget input writes must not sever the source-position synchronization.
    private property <float> slider-value: 0;
    private property <string> source-text: "0";
    changed position-ms => {
        root.slider-value = root.duration-ms > 0 ? root.position-ms * 1.0 / root.duration-ms * 1000.0 : 0;
        root.source-text = root.position-ms;
    }
    changed duration-ms => {
        root.slider-value = root.duration-ms > 0 ? root.position-ms * 1.0 / root.duration-ms * 1000.0 : 0;
    }
    changed source-title => { root.source-text = root.position-ms; }
    callback seek-source(int);
    callback seek-text(string);
    callback cancel-preview();
    background: Theme.canvas;
    PanelHeading { title: "Source viewer"; detail: root.busy ? "Decoding" : root.has-frame ? "Still frame" : root.ready ? "Source" : "No media"; }
    Rectangle {
        x: 0; width: 100%;
        y: Theme.heading-height; height: max(50px,parent.height - Theme.heading-height - 108px);
        Rectangle {
            width: min(parent.width - 32px, (parent.height - 16px) * root.aspect);
            height: self.width / root.aspect;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: #0d0f10; border-width: 1px; border-color: Theme.line;
            if root.has-frame : Image { x: 0; y: 0; width: 100%; height: 100%; source: root.frame; image-fit: contain; }
            if !root.has-frame : VerticalLayout {
                x: 0; y: 0; width: 100%; height: 100%;
                padding: Theme.inset; spacing: Theme.gap; alignment: center;
                if parent.height > 150px : HorizontalLayout {
                    height: 32px; alignment: center;
                    Image { source: @image-url("../assets/viewer.svg"); width: 32px; height: 32px; horizontal-stretch: 0; }
                }
                Text { text: root.status; color: Theme.text; font-size: Theme.heading-size; font-weight: 600; horizontal-alignment: center; wrap: word-wrap; }
                if parent.height > 100px : Text { text: root.detail; color: Theme.secondary; font-size: Theme.label-size; horizontal-alignment: center; wrap: word-wrap; }
            }
            if root.has-frame && root.busy : Rectangle {
                x: 0; y: 0; width: 100%; height: 26px; background: #151719dd;
                Text { text: "Decoding newer source position…"; color: Theme.text; font-size: Theme.label-size; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
    Text { x: Theme.inset; y: parent.height - 106px; width: parent.width - 2 * Theme.inset; height: 20px; text: root.has-frame ? root.caption : root.source-title; color: Theme.secondary; font-size: 11px; overflow: elide; }
    Slider {
        accessible-label: "Source-media position";
        x: Theme.inset; y: parent.height - 84px; width: parent.width - 2 * Theme.inset; height: 24px;
        minimum: 0; maximum: 1000; step: 1;
        value <=> root.slider-value;
        enabled: root.ready && root.duration-ms > 0;
        changed(value) => { root.seek-source(round(value * max(1,root.duration-ms - 1) / 1000)); }
        Tooltip { text: @markdown("Source-media position; the timeline playhead does not move."); }
    }
    HorizontalLayout {
        x: 0; width: 100%;
        y: parent.height - 54px; height: 32px;
        padding-left: Theme.inset; padding-right: Theme.inset; spacing: Theme.gap;
        Text { text: "Source ms"; color: Theme.secondary; font-size: Theme.label-size; vertical-alignment: center; horizontal-stretch: 0; }
        source-input := LineEdit { accessible-label: "Source time in milliseconds"; preferred-width: 90px; min-width: 64px; text <=> root.source-text; enabled: root.ready; accepted => { root.seek-text(self.text); } }
        ActionButton { text: "Seek"; enabled: root.ready; hint: "Request a source frame at these milliseconds"; clicked => { root.seek-text(source-input.text); } }
        ActionButton { text: "+1 s"; enabled: root.ready; hint: "Seek one source second forward"; clicked => { root.seek-source(min(root.position-ms + 1000,root.duration-ms > 0 ? root.duration-ms - 1 : 86400000)); } }
        ActionButton { text: "Cancel"; enabled: root.busy; hint: "Cancel frame decoding"; clicked => { root.cancel-preview(); } }
        ActionButton { text: "Play"; enabled: false; hint: "Playback is not implemented in Phase 1."; }
    }
}
