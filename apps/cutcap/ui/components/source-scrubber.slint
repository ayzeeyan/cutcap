import { Theme, Timecode } from "../theme.slint";

// Source-media position control. Requests seeks only; the displayed position
// always comes from the `position-ms` input (or the active drag), so engine
// updates can never be severed by user interaction.
export component SourceScrubber inherits Rectangle {
    in property <int> position-ms;
    in property <int> duration-ms;
    in property <bool> enabled;
    callback seek(int);
    private property <int> last-ms: max(0, root.duration-ms - 1);
    private property <bool> dragging;
    private property <int> drag-ms;
    private property <int> shown-ms: root.dragging ? root.drag-ms : root.position-ms;
    private property <length> rail-x: 8px;
    private property <length> rail-width: root.width - 2 * root.rail-x;
    private property <float> fraction: root.last-ms > 0 ? clamp(root.shown-ms / root.last-ms, 0, 1) : 0;
    private property <length> thumb-center: root.rail-x + root.rail-width * root.fraction;
    height: 28px;
    min-width: 80px;
    horizontal-stretch: 1;
    accessible-role: slider;
    accessible-label: "Source position";
    accessible-description: "Requests source frames only; the timeline playhead does not move. Arrow keys step 100 ms, Shift+arrow 1 s, Page keys 10 s, Home/End jump to the ends.";
    accessible-enabled: root.enabled;
    accessible-value: Timecode.precise(root.shown-ms);
    accessible-value-minimum: 0;
    accessible-value-maximum: root.last-ms;
    accessible-value-step: 100;
    accessible-action-increment => { root.step(100); }
    accessible-action-decrement => { root.step(-100); }
    forward-focus: scope;

    function request(ms: int) {
        if root.enabled {
            root.seek(clamp(ms, 0, root.last-ms));
        }
    }
    function step(delta: int) {
        root.request(root.position-ms + delta);
    }
    pure function ms-at(x: length) -> int {
        return root.rail-width > 0 ? round(clamp((x - root.rail-x) / root.rail-width, 0, 1) * root.last-ms) : 0;
    }

    rail := Rectangle {
        x: root.rail-x; width: root.rail-width;
        y: (root.height - self.height) / 2; height: 4px;
        border-radius: 2px;
        background: Theme.line-strong;
    }
    Rectangle {
        x: root.rail-x; width: max(0px, root.thumb-center - root.rail-x);
        y: rail.y; height: rail.height;
        border-radius: 2px;
        background: root.enabled ? Theme.accent : transparent;
    }
    if touch.has-hover && root.enabled && !root.dragging : Rectangle {
        x: clamp(touch.mouse-x, root.rail-x, root.rail-x + root.rail-width) - 0.5px; width: 1px;
        y: 4px; height: root.height - 8px;
        background: Theme.pencil.with-alpha(0.6);
    }
    thumb := Rectangle {
        visible: root.enabled;
        width: 14px; height: 14px;
        x: root.thumb-center - self.width / 2;
        y: (root.height - self.height) / 2;
        border-radius: 7px;
        background: Theme.pencil;
        border-width: scope.has-focus ? 3px : 2px;
        border-color: Theme.accent;
        drop-shadow-blur: 4px; drop-shadow-color: #00000080;
    }
    if scope.has-focus : Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        border-radius: Theme.radius; border-width: 1px; border-color: Theme.accent.with-alpha(0.6);
    }
    scope := FocusScope {
        x: 0; y: 0; width: 100%; height: 100%;
        enabled: root.enabled;
        key-pressed(event) => {
            let coarse = event.modifiers.shift ? 1000 : 100;
            if event.text == Key.RightArrow { root.step(coarse); return accept; }
            if event.text == Key.LeftArrow { root.step(-coarse); return accept; }
            if event.text == Key.PageUp { root.step(10000); return accept; }
            if event.text == Key.PageDown { root.step(-10000); return accept; }
            if event.text == Key.Home { root.request(0); return accept; }
            if event.text == Key.End { root.request(root.last-ms); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        x: 0; y: 0; width: 100%; height: 100%;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        pointer-event(event) => {
            if event.button != PointerEventButton.left { return; }
            if event.kind == PointerEventKind.down {
                scope.focus();
                root.dragging = true;
                root.drag-ms = root.ms-at(self.mouse-x);
                root.request(root.drag-ms);
            } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                root.dragging = false;
            }
        }
        moved => {
            if root.dragging {
                let ms = root.ms-at(self.mouse-x);
                if ms != root.drag-ms {
                    root.drag-ms = ms;
                    root.request(ms);
                }
            }
        }
    }
}
