import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { ActionButton } from "action-button.slint";
import { CategoryTab, NavItem } from "tabs.slint";
import { SearchField } from "search-field.slint";
import { MediaItem } from "media-item.slint";
import { MediaRow } from "../models.slint";

// Click target that opens the file picker; it does not accept dropped files.
// `large` is the empty-library call to action, otherwise it is the first grid cell.
component ImportTile inherits Rectangle {
    in property <bool> enabled;
    in property <bool> busy;
    in property <bool> large;
    in property <length> thumb-height: self.height;
    callback clicked();
    callback cancel();
    private property <bool> live: touch.has-hover && root.enabled;
    accessible-role: button;
    accessible-label: root.busy ? "Importing media" : "Import media";
    accessible-description: "Choose a local video file (Ctrl+I)";
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: scope;
    card := Rectangle {
        x: 0; y: 0; width: parent.width; height: root.thumb-height;
        border-radius: Theme.radius + 2px;
        background: touch.pressed && root.enabled ? Theme.pressed : root.live ? Theme.raised : Theme.well;
        border-width: scope.has-focus ? 2px : 1px;
        border-color: scope.has-focus ? Theme.accent : root.live ? Theme.accent.with-alpha(0.55) : Theme.line-strong;
        VerticalLayout {
            alignment: center; spacing: root.large ? 6px : 3px;
            padding-left: 8px; padding-right: 8px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: root.large ? 34px : 24px; height: self.width; horizontal-stretch: 0;
                    border-radius: self.width / 2;
                    background: root.enabled || root.busy ? Theme.accent-fill : Theme.raised;
                    Image {
                        source: root.busy ? @image-url("../assets/icons/import.svg") : @image-url("../assets/icons/plus.svg");
                        colorize: root.enabled || root.busy ? Theme.accent-ink : Theme.faint;
                        width: root.large ? 18px : 14px; height: self.width;
                    }
                }
            }
            Text {
                text: root.busy ? "Importing…" : "Import";
                color: root.enabled || root.busy ? Theme.text : Theme.faint;
                font-size: root.large ? Theme.body-size + 1px : Theme.label-size; font-weight: 600;
                horizontal-alignment: center; overflow: elide;
            }
            if root.large : Text {
                text: root.busy ? "Reading the file with FFprobe" : "Choose a local video · Ctrl+I";
                color: Theme.faint; font-size: Theme.fine-size; horizontal-alignment: center; overflow: elide;
            }
        }
    }
    scope := FocusScope {
        x: 0; y: 0; width: 100%; height: 100%;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        x: 0; y: 0; width: 100%; height: 100%;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { scope.focus(); root.clicked(); }
    }
    if root.busy : ActionButton {
        x: card.width - self.width - 4px; y: 4px;
        width: 24px; height: 24px;
        subtle: true; icon: @image-url("../assets/icons/close.svg"); icon-size: 12px; name: "Cancel import"; hint: "Cancel the current import";
        clicked => { root.cancel(); }
    }
}

export component MediaPanel inherits Rectangle {
    in property <[MediaRow]> entries;
    in property <int> total-count;
    // Collection (0 all, 1 with audio, 2 silent) and name search are view
    // state; Rust reads both and filters the rows.
    in-out property <int> filter;
    in-out property <string> query;
    in property <bool> ready;
    in property <bool> busy;
    in property <bool> error;
    in property <string> status: "Import a local video.";
    callback import-media();
    callback cancel-import();
    callback select-media(int);
    callback filter-changed();
    private property <int> focus-target: -1;
    private property <int> focus-serial;
    // The idle prompt from media_ui duplicates the import tile, so only
    // errors and results are shown as a status line.
    private property <bool> show-status: !root.busy && (root.error || root.status != "Import a local video.");
    private property <length> nav-width: root.width >= 340px ? 92px : 84px;
    // An emptied library (New Project) starts again from the full, unsearched view.
    changed total-count => {
        if root.total-count == 0 { root.filter = 0; root.query = ""; }
    }
    function set-filter(value: int) {
        if root.filter != value { root.filter = value; root.filter-changed(); }
    }
    background: Theme.panel;
    border-radius: Theme.panel-radius;
    clip: true;

    HorizontalLayout {
        x: 0; y: 0; width: 100%; height: Theme.category-height;
        padding-left: 6px; padding-right: 6px; padding-top: 1px; padding-bottom: 1px; spacing: 2px;
        alignment: start;
        CategoryTab { text: "Media"; icon: @image-url("../assets/icons/import.svg"); selected: true; hint: "Imported source media"; }
        CategoryTab { text: "Audio"; icon: @image-url("../assets/icons/music.svg"); enabled: false; hint: "Music and audio-only media arrive in a later phase."; }
        CategoryTab { text: "Text"; icon: @image-url("../assets/icons/text.svg"); enabled: false; hint: "Titles and text arrive with the editing engine."; }
        CategoryTab { text: "Effects"; icon: @image-url("../assets/icons/effects.svg"); enabled: false; hint: "Effects arrive with the editing engine."; }
        if root.width >= 270px : CategoryTab { text: "Transitions"; icon: @image-url("../assets/icons/transition.svg"); enabled: false; hint: "Transitions arrive with the editing engine."; }
        if root.width >= 312px : CategoryTab { text: "Filters"; icon: @image-url("../assets/icons/filters.svg"); enabled: false; hint: "Colour filters arrive with the editing engine."; }
        if root.width >= 354px : CategoryTab { text: "Adjust"; icon: @image-url("../assets/icons/sliders.svg"); enabled: false; hint: "Colour adjustment arrives with the editing engine."; }
    }
    Rectangle { x: 0; y: Theme.category-height; width: 100%; height: 1px; background: Theme.line; }

    nav := VerticalLayout {
        x: 6px; y: Theme.category-height + 1px; width: root.nav-width - 10px; height: parent.height - self.y;
        padding-top: 8px; spacing: 2px; alignment: start;
        NavItem { text: "All media"; selected: root.filter == 0; hint: "Every imported source"; clicked => { root.set-filter(0); } }
        NavItem { text: "With audio"; selected: root.filter == 1; enabled: root.total-count > 0; hint: "Sources that have at least one audio stream"; clicked => { root.set-filter(1); } }
        NavItem { text: "Silent"; selected: root.filter == 2; enabled: root.total-count > 0; hint: "Sources without an audio stream"; clicked => { root.set-filter(2); } }
    }
    Rectangle { x: root.nav-width; y: Theme.category-height + 1px; width: 1px; height: parent.height - self.y; background: Theme.line; }

    content := VerticalLayout {
        x: root.nav-width + 1px; width: parent.width - self.x;
        y: Theme.category-height + 1px; height: parent.height - self.y;
        padding: 10px; padding-bottom: 0px; spacing: 10px;
        HorizontalLayout {
            spacing: 6px;
            SearchField {
                text <=> root.query;
                placeholder: "Search media";
                name: "Search imported media by name";
                enabled: root.total-count > 0;
                edited => { root.filter-changed(); }
            }
            ActionButton {
                height: Theme.control-height + 2px;
                text: content.width >= 250px ? "Import" : "";
                icon: @image-url("../assets/icons/import.svg");
                name: "Import media";
                enabled: root.ready && !root.busy;
                hint: "Import a local video (Ctrl+I)";
                clicked => { root.import-media(); }
            }
        }
        if root.show-status : Rectangle {
            height: status-text.preferred-height + 12px;
            border-radius: Theme.radius;
            background: root.error ? Theme.error.with-alpha(0.1) : Theme.success.with-alpha(0.08);
            status-text := Text {
                x: 10px; y: 6px; width: parent.width - 20px;
                text: root.status; color: root.error ? Theme.error : Theme.muted; font-size: Theme.label-size;
                wrap: word-wrap;
            }
        }
        if root.total-count == 0 : VerticalLayout {
            spacing: 12px; alignment: start; vertical-stretch: 1;
            ImportTile {
                height: 132px; large: true;
                enabled: root.ready && !root.busy; busy: root.busy;
                clicked => { root.import-media(); }
                cancel => { root.cancel-import(); }
            }
            Text { text: "No media yet"; color: Theme.text; font-weight: 600; font-size: Theme.body-size; wrap: word-wrap; }
            Text { text: "Imported videos appear here with their real duration and format. CutCap never changes the original file."; color: Theme.faint; font-size: Theme.label-size; wrap: word-wrap; }
        }
        if root.total-count > 0 : grid := ScrollView {
            vertical-stretch: 1;
            // Cell 0 is the import tile; media entry i sits in cell i + 1.
            property <length> gap: 10px;
            property <length> area: max(60px, self.visible-width - 2px);
            property <int> columns: max(1, floor((self.area + self.gap) / (92px + self.gap)));
            property <length> tile-width: (self.area - (self.columns - 1) * self.gap) / self.columns;
            property <length> tile-height: self.tile-width * 9 / 16 + 22px;
            property <length> row-step: self.tile-height + 8px;
            content-width: self.visible-width;
            content-height: ceil((root.entries.length + 1) / self.columns) * self.row-step + 34px;
            ImportTile {
                x: 0; y: 0; width: grid.tile-width; height: grid.tile-height;
                thumb-height: grid.tile-width * 9 / 16;
                enabled: root.ready && !root.busy; busy: root.busy;
                clicked => { root.import-media(); }
                cancel => { root.cancel-import(); }
            }
            for entry[index] in root.entries : MediaItem {
                x: mod(index + 1, grid.columns) * (grid.tile-width + grid.gap);
                y: floor((index + 1) / grid.columns) * grid.row-step;
                width: grid.tile-width; height: grid.tile-height;
                entry: entry; index: index; count: root.entries.length; columns: grid.columns;
                focus-target: root.focus-target; focus-serial: root.focus-serial;
                activate => { root.select-media(entry.source-index); }
                move(delta) => {
                    let target = index + delta;
                    if target >= 0 && target < root.entries.length && target != index {
                        root.select-media(root.entries[target].source-index);
                        root.focus-target = target;
                        root.focus-serial += 1;
                    }
                }
            }
            if root.entries.length == 0 : Text {
                x: 0; y: grid.row-step; width: grid.area;
                text: root.query != "" ? "No media name matches this search." : root.filter == 1 ? "No imported source has audio." : "Every imported source has audio.";
                color: Theme.faint; font-size: Theme.label-size; wrap: word-wrap;
            }
        }
    }
}
