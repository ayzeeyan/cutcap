import { Theme } from "../theme.slint";

// Icon-over-label tool tab across the top of the library. Tools the engine
// cannot back yet are shown disabled with an explanation.
export component CategoryTab inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <string> hint;
    callback clicked();
    private property <color> ink: root.selected ? Theme.accent : root.enabled ? (touch.has-hover ? Theme.text : Theme.muted) : Theme.faint.with-alpha(0.6);
    min-width: max(42px, label.preferred-width + 10px);
    preferred-width: self.min-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    background: touch.has-hover && root.enabled && !root.selected ? Theme.hover.with-alpha(0.5) : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-description: root.hint;
    accessible-enabled: root.enabled;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: scope;
    Image {
        source: root.icon; colorize: root.ink;
        x: (parent.width - 18px) / 2; y: 8px; width: 18px; height: 18px;
    }
    label := Text {
        x: 0; width: parent.width; y: 30px;
        text: root.text; color: root.ink;
        font-size: Theme.fine-size; font-weight: root.selected ? 600 : 400;
        horizontal-alignment: center;
    }
    if scope.has-focus : Rectangle {
        border-radius: Theme.radius; border-width: 1.5px; border-color: Theme.accent;
    }
    scope := FocusScope {
        x: 0; y: 0; width: 100%; height: 100%;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        x: 0; y: 0; width: 100%; height: 100%;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if root.enabled { scope.focus(); root.clicked(); } }
    }
    if root.hint != "" : Tooltip { text: @markdown("\{root.hint}"); }
}

// Text tab used in panel headings; the selected tab is accent with an underline.
export component ViewTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <string> hint;
    callback clicked();
    min-width: label.preferred-width + 16px;
    preferred-width: self.min-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    background: touch.has-hover && root.enabled && !root.selected ? Theme.hover.with-alpha(0.5) : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-description: root.hint;
    accessible-enabled: root.enabled;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    forward-focus: scope;
    label := Text {
        text: root.text;
        color: root.selected ? Theme.accent : root.enabled ? Theme.muted : Theme.faint.with-alpha(0.7);
        font-size: Theme.label-size; font-weight: root.selected ? 600 : 400;
        horizontal-alignment: center; vertical-alignment: center;
    }
    if root.selected : Rectangle {
        x: 8px; width: parent.width - 16px; y: parent.height - 2px; height: 2px;
        border-radius: 1px; background: Theme.accent;
    }
    if scope.has-focus : Rectangle {
        border-radius: Theme.radius; border-width: 1.5px; border-color: Theme.accent;
    }
    scope := FocusScope {
        x: 0; y: 0; width: 100%; height: 100%;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        x: 0; y: 0; width: 100%; height: 100%;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if root.enabled { scope.focus(); root.clicked(); } }
    }
    if root.hint != "" : Tooltip { text: @markdown("\{root.hint}"); }
}

// Vertical sub-navigation entry (library collections).
export component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <string> hint;
    callback clicked();
    height: 30px;
    border-radius: Theme.radius;
    background: root.selected ? Theme.raised : touch.has-hover && root.enabled ? Theme.hover.with-alpha(0.5) : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-description: root.hint;
    accessible-enabled: root.enabled;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: scope;
    Text {
        x: 10px; width: parent.width - 14px; height: 100%;
        text: root.text;
        color: root.selected ? Theme.text : root.enabled ? Theme.muted : Theme.faint.with-alpha(0.7);
        font-size: Theme.label-size; font-weight: root.selected ? 600 : 400;
        vertical-alignment: center; overflow: elide;
    }
    if scope.has-focus : Rectangle {
        border-radius: Theme.radius; border-width: 1.5px; border-color: Theme.accent;
    }
    scope := FocusScope {
        x: 0; y: 0; width: 100%; height: 100%;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        x: 0; y: 0; width: 100%; height: 100%;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if root.enabled { scope.focus(); root.clicked(); } }
    }
    if root.hint != "" : Tooltip { text: @markdown("\{root.hint}"); }
}
