import { Theme } from "../theme.slint";

// Panel title row: icon, title, muted detail, then right-aligned actions.
export component PanelHeading inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <image> icon;
    in property <bool> divider: true;
    height: Theme.heading-height;
    x: 0; y: 0; width: 100%;
    HorizontalLayout {
        x: 0; y: 0; width: 100%; height: 100%;
        padding-left: Theme.inset + 2px; padding-right: 6px; spacing: Theme.gap;
        if root.icon.width > 0 : Rectangle {
            width: 16px; horizontal-stretch: 0;
            Image { source: root.icon; colorize: Theme.muted; x: 0; y: (parent.height - 16px) / 2; width: 16px; height: 16px; }
        }
        Text { text: root.title; color: Theme.text; font-size: Theme.heading-size; font-weight: 600; vertical-alignment: center; horizontal-stretch: 0; }
        Text { text: root.detail; color: Theme.faint; font-size: Theme.label-size; vertical-alignment: center; overflow: elide; min-width: 0px; horizontal-stretch: 1; }
        HorizontalLayout {
            padding-top: 6px; padding-bottom: 6px; spacing: 2px; horizontal-stretch: 0;
            @children
        }
    }
    if root.divider : Rectangle { x: 0; y: parent.height - 1px; width: 100%; height: 1px; background: Theme.line; }
}
