import { Theme } from "../theme.slint";

export component PanelHeading inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    height: Theme.heading-height;
    x: 0; y: 0; width: 100%;
    background: Theme.panel;
    HorizontalLayout {
        x: 0; y: 0; width: 100%; height: 100%;
        padding-left: Theme.inset; padding-right: Theme.inset; spacing: Theme.gap;
        Text { text: root.title; color: Theme.text; font-size: Theme.heading-size; font-weight: 600; vertical-alignment: center; }
        Text { text: root.detail; color: Theme.secondary; font-size: Theme.label-size; horizontal-alignment: right; vertical-alignment: center; }
    }
    Rectangle { x: 0; y: parent.height - 1px; width: 100%; height: 1px; background: Theme.line; }
}
