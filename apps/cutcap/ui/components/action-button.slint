import { Theme } from "../theme.slint";

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <bool> enabled: true;
    in property <bool> subtle: false;
    callback clicked();
    height: 32px;
    min-width: label.preferred-width + Theme.section;
    preferred-width: self.min-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.accent : (root.subtle ? transparent : Theme.line);
    background: !root.enabled ? Theme.panel : touch.pressed ? Theme.selection : touch.has-hover ? Theme.hover : root.subtle ? transparent : Theme.raised;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-description: root.hint;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    label := Text {
        x: 0; y: 0; width: 100%; height: 100%;
        text: root.text;
        color: root.enabled ? Theme.text : Theme.disabled;
        font-size: Theme.label-size;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    focus := FocusScope {
        x: 0; y: 0; width: 100%; height: 100%;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        x: 0; y: 0; width: 100%; height: 100%;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { focus.focus(); root.clicked(); }
    }
    Tooltip { text: @markdown("\{root.hint}"); }
}
