import { Theme } from "../theme.slint";
import { MediaRow } from "../models.slint";

// One library grid tile. The whole tile is the selection target; arrow keys
// ask the panel to move selection and focus to a neighbouring cell.
export component MediaItem inherits Rectangle {
    in property <MediaRow> entry;
    in property <int> index;
    in property <int> count;
    in property <int> columns: 1;
    in property <int> focus-target: -1;
    in property <int> focus-serial;
    callback activate();
    callback move(int);
    changed focus-serial => {
        if root.focus-target == root.index { scope.focus(); }
    }
    accessible-role: list-item;
    accessible-label: root.entry.name;
    accessible-description: root.entry.resolution + ", " + root.entry.format + ", " + (root.entry.estimated ? "about " : "") + root.entry.duration + (root.entry.has-audio ? ", with audio" : ", no audio");
    accessible-item-selectable: true;
    accessible-item-selected: root.entry.selected;
    accessible-item-index: root.index;
    accessible-item-count: root.count;
    accessible-action-default => { root.activate(); }
    forward-focus: scope;
    // Frame-shaped tile. No thumbnail is invented: poster frames need an
    // engine API, so the tile shows the media family and real duration.
    thumb := Rectangle {
        x: 0; y: 0; width: parent.width; height: self.width * 9 / 16;
        border-radius: Theme.radius + 2px;
        background: @linear-gradient(150deg, #1f3337 0%, #18181b 70%);
        clip: true;
        Image {
            source: @image-url("../assets/icons/film.svg");
            colorize: root.entry.selected ? Theme.accent : touch.has-hover ? Theme.muted : Theme.faint;
            width: 20px; height: 20px;
        }
        if root.entry.has-audio : Rectangle {
            x: 4px; y: 4px; width: 18px; height: 16px;
            border-radius: 3px; background: #000000a0;
            Image {
                source: @image-url("../assets/icons/audio-badge.svg");
                colorize: Theme.audio; width: 11px; height: 11px;
                accessible-role: image; accessible-label: "Has audio";
            }
        }
        Rectangle {
            x: parent.width - self.width - 4px; y: parent.height - self.height - 4px;
            width: stamp.preferred-width + 8px; height: 16px;
            border-radius: 3px; background: #000000b0;
            stamp := Text {
                text: (root.entry.estimated ? "≈" : "") + root.entry.duration;
                color: Theme.pencil; font-family: Theme.mono-family; font-size: 10px;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
        if touch.has-hover && !root.entry.selected : Rectangle { background: #ffffff0d; }
    }
    if root.entry.selected || scope.has-focus : Rectangle {
        x: thumb.x; y: thumb.y; width: thumb.width; height: thumb.height;
        border-radius: thumb.border-radius;
        border-width: 2px; border-color: Theme.accent;
    }
    Text {
        x: 1px; y: thumb.height + 5px; width: parent.width - 2px;
        text: root.entry.name;
        color: root.entry.selected ? Theme.text : Theme.muted;
        font-size: Theme.fine-size; font-weight: root.entry.selected ? 600 : 400;
        overflow: elide;
    }
    scope := FocusScope {
        x: 0; y: 0; width: 100%; height: 100%;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.activate(); return accept; }
            if event.text == Key.LeftArrow { root.move(-1); return accept; }
            if event.text == Key.RightArrow { root.move(1); return accept; }
            if event.text == Key.UpArrow { root.move(-root.columns); return accept; }
            if event.text == Key.DownArrow { root.move(root.columns); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        x: 0; y: 0; width: 100%; height: 100%;
        mouse-cursor: pointer;
        clicked => { scope.focus(); root.activate(); }
    }
    Tooltip { text: @markdown("**\{root.entry.name}** · \{root.entry.resolution} · \{root.entry.format}"); }
}
